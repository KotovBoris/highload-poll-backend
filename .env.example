# Скопируйте в .env и при необходимости измените.
# docker-compose.yml использует значения по умолчанию, если файла нет.

# --- API-воркер ---
HTTP_ADDR=:8080
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=votes
RESULTS_URL=http://results:8081
VOTE_BATCH_SIZE=10000
POLL_CACHE_TTL=1m
CLOSE_CHECK_INTERVAL=500ms

# Секрет HMAC-подписи cookie voter_id. Пустой — генерируется случайный
# (куки не выживают рестарт; годится только для локального запуска).
COOKIE_SECRET=dev-cookie-secret-change-me
# Предел числа записей лимитера выдачи cookie (0 — без предела).
MAX_ISSUED_ENTRIES=1000000
# Сколько cookie можно выдать одному IP в рамках опроса (0 — без ограничения).
MAX_COOKIES_PER_CLIENT=1000
# Отключить лимит выдачи (только для нагрузочного теста).
DISABLE_ISSUE_LIMIT=false

# --- Consumer ---
KAFKA_GROUP_ID=poll-consumers
COMMIT_DONE_PERCENT=90
COMMIT_STALE_MESSAGES=1000
CLOSE_GRACE=5s
CLOSE_HARD_TIMEOUT=1m

# --- Results ---
# Локальный dev: trust-аутентификация postgres, пароль не нужен.
DATABASE_URL=postgres://poll@postgres:5432/poll?sslmode=disable
DB_MAX_CONNS=20
